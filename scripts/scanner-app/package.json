{
  "name": "mintvault-scanner-app",
  "version": "1.6.1",
  "description": "MintVault scanner menu-bar app — single-process replacement for watcher.mjs + guide-window + swiftbar.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "package:mac": "node scripts/package-macos.js",
