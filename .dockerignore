.env
.env.*
**/.env
**/.env.*
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
*.dump
**/*.dump
*.backup
**/*.backup
*.sqlite
**/*.sqlite
*.sqlite3
**/*.sqlite3
.npmrc
**/.npmrc
.netrc
**/.netrc

